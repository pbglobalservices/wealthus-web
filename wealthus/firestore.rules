rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is superadmin strictly
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'testcodecfg@gmail.com';
    }
    
    // Check if user is registered staff
    function isStaff() {
      return isSuperAdmin() || exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    // Contacts (Inquiries)
    match /contacts/{document=**} {
      allow create: if true; // Public can submit
      allow read, update, delete: if isStaff(); // Only staff can manage
    }
    
    // Goals
    match /goals/{goalId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Consultations (Meetings)
    match /consultations/{consultationId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isStaff());
      allow write: if isStaff(); // Only staff can add meeting notes
    }
    
    // Staff Collection
    match /staff/{staffId} {
      allow read: if request.auth != null && (request.auth.uid == staffId || isSuperAdmin());
      allow write: if isSuperAdmin(); // ONLY superadmin can create/edit staff
    }

    // NEW: Customer Support Ticket System
    match /support_tickets/{ticketId} {
      // Users can create their own tickets
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // Users can read their own tickets; Staff can read all tickets
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || isStaff());
      // Staff can update tickets (e.g., change status); Users can update their own tickets (e.g., add replies)
      allow update: if isStaff() || (request.auth != null && request.auth.uid == resource.data.userId);
      // Only Superadmin can delete tickets
      allow delete: if isSuperAdmin();
    }

    // NEW: Feedback Forms
    match /feedback/{feedbackId} {
      // Anyone can submit feedback
      allow create: if true; 
      // Only staff can read and manage feedback
      allow read, update, delete: if isStaff();
    }

    // NEW: Household Budget Planner
    match /user_budgets/{budgetId} {
      // Users can strictly only read and write their own budget data
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // NEW: Net Worth Tracker
    match /user_net_worth/{netWorthId} {
      // Users can strictly only read and write their own net worth data
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
  }
}